{
  "builds": [
    {
      "src": "api/stock.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "hk_core.py" }
    },
    {
      "src": "api/hk_core.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
